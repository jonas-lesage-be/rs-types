{
  "workspace": ["./eslint-plugins/*"],
  "license": "MIT",
  "version": "0.1.0",
  "nodeModulesDir": "auto",
  "tasks": {
    "fmt": "prettier --write ./*.* ./src/ --no-error-on-unmatched-pattern --ignore-unknown",
    "lint": "oxlint && eslint --cache",
    "lint:fix": "oxlint --fix && eslint --fix --cache"
  },
  "test": {
    "exclude": ["*/**"]
  },
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["deno.window", "deno.ns", "ES2025"]
  },
  "imports": {
    "@/": "./src/",
    "@e18e/eslint-plugin": "npm:@e18e/eslint-plugin@^0.6.0",
    "@eslint/js": "npm:@eslint/js@^10.0.1",
    "@eslint/json": "npm:@eslint/json@^2.0.1",
    "@eslint/markdown": "npm:@eslint/markdown@^8.0.3",
    "eslint": "npm:eslint@^10.9.1",
    "eslint-config-prettier": "npm:eslint-config-prettier@^10.1.8",
    "eslint-plugin-oxlint": "npm:eslint-plugin-oxlint@^1.80.0",
    "eslint-plugin-perfectionist": "npm:eslint-plugin-perfectionist@^5.10.1",
    "eslint-plugin-sonarjs": "npm:eslint-plugin-sonarjs@^4.2.0",
    "eslint-plugin-unicorn": "npm:eslint-plugin-unicorn@^72.0.0",
    "oxlint": "npm:oxlint@^1.80.0",
    "prettier": "npm:prettier@^3.9.6",
    "typescript": "npm:typescript@^5.9.3",
    "typescript-eslint": "npm:typescript-eslint@^8.68.0",
    "vitest": "npm:vitest@^4.1.11"
  }
}
