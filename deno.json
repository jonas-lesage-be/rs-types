{
  "name": "@jonas-lesage-be/rs-types",
  "version": "0.5.1",
  "description": "A library that provides Rust types in TypeScript.",
  "author": "Jonas Lesage <jonas.lesage@outlook.com>",
  "license": "MIT",
  "exports": "./mod.ts",
  "nodeModulesDir": "auto",
  "publish": {
    "include": ["mod.ts", "src/**/*.ts", "deno.json", "README.md", "LICENSE"]
  },
  "tasks": {
    "fmt": "prettier --write ./*.* ./src/ --no-error-on-unmatched-pattern --ignore-unknown",
    "lint": "oxlint && eslint --cache",
    "lint:fix": "oxlint --fix && eslint --fix --cache",
    "test": "vitest run --coverage"
  },
  "test": {
    "exclude": ["*/**"]
  },
  "imports": {
    "@/": "./src/",
    "@deno/dnt": "jsr:@deno/dnt@^0.43.2",
    "@e18e/eslint-plugin": "npm:@e18e/eslint-plugin@^0.6.0",
    "@eslint/js": "npm:@eslint/js@^10.0.1",
    "@eslint/json": "npm:@eslint/json@^2.1.0",
    "@eslint/markdown": "npm:@eslint/markdown@^8.0.3",
    "@vitest/coverage-v8": "npm:@vitest/coverage-v8@5.0.0",
    "@vitest/ui": "npm:@vitest/ui@^5.0.0",
    "eslint": "npm:eslint@^10.10.0",
    "eslint-config-prettier": "npm:eslint-config-prettier@^10.1.8",
    "eslint-plugin-mod-boundaries": "npm:eslint-plugin-mod-boundaries@^0.5.1",
    "eslint-plugin-oxlint": "npm:eslint-plugin-oxlint@^1.82.0",
    "eslint-plugin-perfectionist": "npm:eslint-plugin-perfectionist@^5.11.0",
    "eslint-plugin-sonarjs": "npm:eslint-plugin-sonarjs@^4.2.0",
    "eslint-plugin-unicorn": "npm:eslint-plugin-unicorn@^72.0.0",
    "oxlint": "npm:oxlint@^1.82.0",
    "pino": "npm:pino@^10.3.1",
    "pino-pretty": "npm:pino-pretty@^13.1.3",
    "prettier": "npm:prettier@^3.9.6",
    "typescript": "npm:typescript@^5.9.3",
    "typescript-eslint": "npm:typescript-eslint@^8.70.0",
    "vitest": "npm:vitest@^5.0.0"
  },
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["deno.window", "deno.ns", "ES2025"]
  }
}
